# ============================================================
# NocSentinel — Ortam Değişkenleri Şablonu
# KULLANIM: Bu dosyayı ".env" olarak kopyalayın ve gerçek değerleri girin.
#   cp .env.example .env
# NOT: .env dosyasını asla Git'e commit etmeyin! Sadece .env.example commit edilir.
# ============================================================

# --- Şifreleme Güvenlik Anahtarı ---
# AES-GCM için paylaşılan anahtar. İstemci ve sunucu aynı değeri kullanmalıdır.
# Güçlü anahtar üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
CRYPTO_SHARED_TOKEN=TOGU2024

# --- DeepSeek AI API Anahtarı ---
# https://platform.deepseek.com adresinden edinebilirsiniz.
# Boş bırakırsanız Fallback (yerel kural motoru) modunda çalışır.
DEEPSEEK_API_KEY=

# --- Ortam Modu ---
# production : TLS hostname dogrulamasi AKTIF (guvenli)
# development: TLS hostname dogrulamasi KAPALI (self-signed kolaylik)
NOC_ENV=production

# --- MQTT Broker ---
# TLS/SSL ile çalışıyorsanız güvenli port 8883'ü kullanın.
# TLS olmadan çalışıyorsanız 1883'e alın.
MQTT_BROKER=localhost
MQTT_PORT=8883

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
